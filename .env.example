# =============================================================
# Ali Khan Portfolio — environment configuration
# Copy this file to `.env.local` and fill in the real values.
# NOTHING here is invented — every value must be supplied by Ali.
# =============================================================

# Production domain, e.g. https://alikhan.dev  (no trailing slash)
# Used for canonical URLs, Open Graph URLs, sitemap.xml and robots.txt.
# If left unset, the site builds with relative URLs and the sitemap/robots
# files should be regenerated once the domain is known.
NEXT_PUBLIC_SITE_URL=

# n8n Form-Trigger webhook URL. NOTE: the public contact form no longer uses
# this — it now opens WhatsApp (click-to-chat) instead, so the form works with
# no webhook configured. This variable is kept only for optional custom n8n
# integrations you may wire up later; leave empty unless needed.
# This is a PUBLIC submission endpoint (like a Google Form action URL);
# never place private API keys or credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# ---------------------------------------------------------------
# Sanity (blog CMS) — project ktndwv6h, dataset production
# ---------------------------------------------------------------

# Public identifiers (safe to expose; also set in studio-portfolio config)
NEXT_PUBLIC_SANITY_PROJECT_ID=ktndwv6h
NEXT_PUBLIC_SANITY_DATASET=production

# Server-side ONLY. Read token from Sanity manage.sanity.io -> API -> Tokens
# (Viewer role). Used for draft-aware queries/preview. NEVER prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Shared secret used to sign/verify the Sanity webhook that triggers
# on-demand revalidation of /blog pages after Publish/Unpublish.
# Generate locally, e.g.:  openssl rand -hex 32
# Enter the SAME value in Sanity API -> Webhooks and in Vercel env vars.
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------
# Optional public contact-method overrides for the UI.
# When empty, the site falls back to the verified details in data/site.js
# (email: alikhan.contact@gmail.com, WhatsApp: +923215720722).
# Never shown as a placeholder or an empty mailto: link.
# ---------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=

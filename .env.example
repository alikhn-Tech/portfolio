# Canonical origin used for metadata, sitemap and robots.
# Set this to your production domain once the site is live on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed when the site is served from a sub-path, e.g. GitHub Pages.
# NEXT_PUBLIC_BASE_PATH=/your-repo-name

# Sanity CMS — values are visible in sanity.io/manage.
# Without these the site still builds; the blog simply renders an empty state.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Only for a private dataset. Leave empty for public content.
# SANITY_API_READ_TOKEN=
